# Server Configuration
PORT=5000
NODE_ENV=production

# Allowed Frontend Origin for CORS (comma-separated for multiple origins, e.g. Vercel deployment URL)
CLIENT_ORIGIN=https://YOUR-FRONTEND-URL.vercel.app

# MongoDB Atlas Connection String
# Format: mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/nextgen_mobile?retryWrites=true&w=majority
