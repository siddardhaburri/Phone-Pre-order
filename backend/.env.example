# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed Frontend Origin for CORS (comma-separated for multiple origins)
CLIENT_ORIGIN=http://localhost:5174,http://127.0.0.1:5174

# MongoDB Atlas Connection String
# Format: mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/<database>?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/nextgen_mobile?retryWrites=true&w=majority
